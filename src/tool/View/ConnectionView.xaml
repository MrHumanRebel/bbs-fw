<UserControl xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" x:Class="BBSFW.View.ConnectionView" Style="{StaticResource {x:Type UserControl}}">
 <UserControl.Resources><BooleanToVisibilityConverter x:Key="BoolToVis"/></UserControl.Resources>
 <Grid VerticalAlignment="Top" MaxHeight="560">
  <Grid.ColumnDefinitions><ColumnDefinition Width="1.15*"/><ColumnDefinition Width="20"/><ColumnDefinition/></Grid.ColumnDefinitions>
  <Border Style="{StaticResource Card}">
   <Grid>
    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition MinHeight="230" Height="*"/></Grid.RowDefinitions>
    <DockPanel LastChildFill="True">
     <Button DockPanel.Dock="Right" Content="Refresh" Command="{Binding RefreshCommand}" Margin="16,0,0,0"/>
     <TextBlock Text="Available controllers" FontSize="22" FontWeight="SemiBold" VerticalAlignment="Center" TextWrapping="Wrap"/>
    </DockPanel>
    <TextBlock Grid.Row="1" Text="Select your programming adapter to connect." Style="{StaticResource Caption}" Margin="0,10,0,20" TextWrapping="Wrap"/>
    <ListView Grid.Row="2" x:Name="PortList" ItemsSource="{Binding ComPorts}" SelectedItem="{Binding SelectedComPort}" ScrollViewer.HorizontalScrollBarVisibility="Disabled">
     <ListView.ItemTemplate><DataTemplate><StackPanel>
      <TextBlock Text="{Binding Name}" FontWeight="SemiBold"/>
      <TextBlock Text="{Binding Description}" Style="{StaticResource Caption}" TextWrapping="Wrap" Margin="0,4,0,0"/>
     </StackPanel></DataTemplate></ListView.ItemTemplate>
    </ListView>
    <StackPanel Grid.Row="2" VerticalAlignment="Center" HorizontalAlignment="Center" IsHitTestVisible="False">
     <StackPanel.Style><Style TargetType="StackPanel"><Setter Property="Visibility" Value="Collapsed"/><Style.Triggers><DataTrigger Binding="{Binding ComPorts.Count}" Value="0"><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers></Style></StackPanel.Style>
     <TextBlock Text="No adapter found" FontSize="18" HorizontalAlignment="Center"/>
     <TextBlock Text="Plug in the USB adapter, then refresh." Style="{StaticResource Caption}" Margin="0,8" TextWrapping="Wrap"/>
    </StackPanel>
   </Grid>
  </Border>
  <Border Grid.Column="2" Style="{StaticResource Card}" VerticalAlignment="Top">
   <StackPanel>
    <TextBlock Text="Controller link" FontSize="22" FontWeight="SemiBold"/>
    <TextBlock Text="Connect, read the controller configuration, then review your settings before writing changes." Style="{StaticResource Caption}" TextWrapping="Wrap" Margin="0,10,0,24"/>
    <StackPanel Visibility="{Binding IsDisconnected, Converter={StaticResource BoolToVis}}">
     <Button Content="Connect" Command="{Binding ConnectCommand}">
      <Button.Style><Style TargetType="Button" BasedOn="{StaticResource PrimaryButton}"><Style.Triggers>
       <DataTrigger Binding="{Binding SelectedComPort}" Value="{x:Null}"><Setter Property="IsEnabled" Value="False"/></DataTrigger>
       <DataTrigger Binding="{Binding IsConnecting}" Value="True"><Setter Property="Visibility" Value="Collapsed"/></DataTrigger>
      </Style.Triggers></Style></Button.Style>
     </Button>
     <Button Content="Cancel" Command="{Binding DisconnectCommand}" Visibility="{Binding IsConnecting, Converter={StaticResource BoolToVis}}"/>
     <ProgressBar IsIndeterminate="True" Margin="0,14,0,0" Height="4" Visibility="{Binding IsConnecting, Converter={StaticResource BoolToVis}}"/>
    </StackPanel>
    <StackPanel Visibility="{Binding IsConnected, Converter={StaticResource BoolToVis}}">
     <TextBlock Text="Connected" Foreground="{DynamicResource AccentBrush}" FontSize="18"/>
     <TextBlock Text="{Binding Controller}" FontSize="28" Margin="0,8"/>
     <TextBlock Text="{Binding FirmwareVersion, StringFormat=Firmware {0}}" Style="{StaticResource Caption}"/>
     <Button Content="Disconnect" Command="{Binding DisconnectCommand}" Margin="0,24,0,0"/>
    </StackPanel>
   </StackPanel>
  </Border>
 </Grid>
</UserControl>
