<Window x:Class="BBSFW.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:BBSFW"
		xmlns:vm="clr-namespace:BBSFW.ViewModel"
		xmlns:vw="clr-namespace:BBSFW.View"
        mc:Ignorable="d"
        Style="{StaticResource {x:Type Window}}" Title="BBS-FW Studio" Height="820" Width="1180" MinWidth="1000" MinHeight="650"
        Icon="/BBSFWTool;component/Assets/Studio.png" WindowStartupLocation="CenterScreen">

	<Window.DataContext>
		<vm:MainViewModel />
	</Window.DataContext>

	<Grid Background="{DynamicResource CanvasBrush}">

		<Grid.RowDefinitions>
			<RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
			<RowDefinition />
            <RowDefinition Height="Auto" />
		</Grid.RowDefinitions>
		
		<Menu Grid.Row="0" Margin="20,8,20,0">
			<MenuItem Header="File" VerticalContentAlignment="Center">
				<MenuItem Header="Open..." IsEnabled="{Binding CanUseFiles}" Command="{Binding OpenConfigCommand}" />
				<MenuItem Header="Save As..." IsEnabled="{Binding CanUseFiles}" Command="{Binding SaveConfigCommand}" />
				<Separator />
				<MenuItem Header="Save Log..." Command="{Binding SaveLogCommand}" />
				<Separator />
				<MenuItem Header="Exit" Command="{Binding ExitCommand}" />
			</MenuItem>
			<MenuItem Header="Flash" VerticalContentAlignment="Center">
				<MenuItem Header="Read" IsEnabled="{Binding CanUseController}" Command="{Binding ReadFlashCommand}" />
				<MenuItem Header="Write" IsEnabled="{Binding CanUseController}" Command="{Binding WriteFlashCommand}" />
				<Separator />
				<MenuItem Header="Reset" IsEnabled="{Binding CanUseController}" Command="{Binding ResetFlashCommand}" />
			</MenuItem>
			<MenuItem Header="Options" VerticalContentAlignment="Center">
				<MenuItem Header="Units">
					<MenuItem Header="Metric" IsCheckable="True" IsChecked="{Binding ConfigVm.UseMetricUnits}" />
					<MenuItem Header="Imperial" IsCheckable="True" IsChecked="{Binding ConfigVm.UseImperialUnits}" />
				</MenuItem>
			</MenuItem>
			<MenuItem Header="Help" VerticalContentAlignment="Center">
				<MenuItem Header="About" Command="{Binding ShowAboutCommand}" />
			</MenuItem>
		</Menu>

		<Grid Grid.Row="1" Margin="30,24,30,24">
            <StackPanel>
                <StackPanel Orientation="Horizontal">
                    <Image Source="/BBSFWTool;component/Assets/Studio.png" Width="40" Height="40" Margin="0,0,12,0"/><TextBlock Text="BBS" FontSize="30" FontWeight="Bold" />
                    <TextBlock Text=" / STUDIO" FontSize="30" FontWeight="Light" Foreground="{DynamicResource MutedBrush}" />
                </StackPanel>
                <TextBlock Text="Your drive. Your settings." Style="{StaticResource Caption}" Margin="0,4,0,0"/>
            </StackPanel>
            <Button x:Name="ThemeButton" Content="Light mode" Click="ToggleTheme" HorizontalAlignment="Right" VerticalAlignment="Center" ToolTip="Switch between light and dark appearance" AutomationProperties.Name="Toggle color theme"/>
        </Grid>
        <TabControl x:Name="WorkspaceTabs" Style="{StaticResource SidebarTabs}" TabStripPlacement="Left" Margin="20,0,24,16" Grid.Row="2" SelectionChanged="WorkspaceChanged">
			<TabItem Header="Connection" Tag="&#xE839;">
				<vw:ConnectionView Margin="0" />
			</TabItem>
			<TabItem Header="Virtual Display" Tag="&#xE7F4;">
                <ScrollViewer VerticalScrollBarVisibility="Auto"><vw:VirtualDisplayView Margin="0" DataContext="{Binding VirtualDisplayVm}" /></ScrollViewer>
            </TabItem>
			<TabItem Header="System" Tag="&#xE713;">
				<vw:SystemView />
			</TabItem>
			<TabItem Header="Assist Levels" Tag="&#xE9E9;">
				<vw:AssistLevelsView Margin="0" DataContext="{Binding AssistLevelsVm}" />
			</TabItem>
			<TabItem Header="Calibration" Tag="&#xE9D9;" DataContext="{Binding CalibrationVm}">
				<ScrollViewer VerticalScrollBarVisibility="Auto"><vw:CalibrationView Margin="0,0,12,0" /></ScrollViewer>
			</TabItem>
			<TabItem Header="Event Log" Tag="&#xE9D5;" DataContext="{Binding EventLogVm}">
				<vw:EventLogView Margin="0" />
			</TabItem>
		</TabControl>
        <Border Grid.Row="3" Background="{DynamicResource SurfaceBrush}" Padding="30,10">
            <DockPanel>
                <TextBlock Text="BBS02 / BBSHD / TSDZ2" Style="{StaticResource Caption}" DockPanel.Dock="Right"/>
                <StackPanel Orientation="Horizontal">
                    <Ellipse Width="7" Height="7" Margin="0,0,8,0">
                        <Ellipse.Style><Style TargetType="Ellipse">
                            <Setter Property="Fill" Value="{DynamicResource MutedBrush}"/>
                            <Style.Triggers><DataTrigger Binding="{Binding ConnectionVm.IsConnected}" Value="True"><Setter Property="Fill" Value="{DynamicResource AccentBrush}"/></DataTrigger></Style.Triggers>
                        </Style></Ellipse.Style>
                    </Ellipse>
                    <TextBlock><TextBlock.Style><Style TargetType="TextBlock" BasedOn="{StaticResource Caption}">
                        <Setter Property="Text" Value="Disconnected"/>
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding ConnectionVm.IsConnected}" Value="True"><Setter Property="Text" Value="Controller connected"/></DataTrigger>
                            <DataTrigger Binding="{Binding ConnectionVm.IsConnecting}" Value="True"><Setter Property="Text" Value="Connecting…"/></DataTrigger>
                        </Style.Triggers>
                    </Style></TextBlock.Style></TextBlock>
                </StackPanel>
            </DockPanel>
        </Border>
		
	</Grid>
</Window>
