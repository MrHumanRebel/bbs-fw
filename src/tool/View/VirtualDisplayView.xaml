<UserControl xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" x:Class="BBSFW.View.VirtualDisplayView" Loaded="OnLoaded" Unloaded="OnUnloaded" Style="{StaticResource {x:Type UserControl}}">
 <StackPanel>
  <TextBlock Text="Virtual display" FontSize="26" FontWeight="SemiBold"/>
  <TextBlock Text="Live telemetry &amp; bench controls" Style="{StaticResource Caption}" Margin="0,4,0,24"/>
  <Grid>
   <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="16"/><ColumnDefinition/></Grid.ColumnDefinitions>
   <Border Style="{StaticResource Card}" Background="{DynamicResource InputBrush}">
    <StackPanel><TextBlock Text="SPEED" Style="{StaticResource Caption}"/><TextBlock Text="{Binding Speed}" FontSize="38" FontWeight="Light" Margin="0,8,0,0"/></StackPanel>
   </Border>
   <Border Grid.Column="2" Style="{StaticResource Card}" Background="{DynamicResource InputBrush}">
    <StackPanel><TextBlock Text="POWER" Style="{StaticResource Caption}"/><TextBlock Text="{Binding Power}" Foreground="{DynamicResource AccentBrush}" FontSize="38" FontWeight="Light" Margin="0,8,0,0"/></StackPanel>
   </Border>
  </Grid>

  <Border Height="20"/>
  <Grid>
   <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="16"/><ColumnDefinition/></Grid.ColumnDefinitions>
  <Border Style="{StaticResource Card}" Background="{DynamicResource InputBrush}">
   <StackPanel>
    <CheckBox IsEnabled="{Binding Supported}" IsChecked="{Binding ControlsEnabled}"><TextBlock Text="Enable bench controls (driven wheel clear)" TextWrapping="Wrap"/></CheckBox>
    <StackPanel IsEnabled="{Binding ControlsEnabled}" Margin="0,16,0,0">
     <DockPanel>
      <TextBlock Text="Assist level" VerticalAlignment="Center"/>
      <ComboBox ItemsSource="{Binding Levels}" SelectedItem="{Binding SelectedLevel}" Width="90" HorizontalAlignment="Right"/>
     </DockPanel>
     <TextBlock Text="Virtual throttle" Margin="0,16,0,0" FontWeight="SemiBold"/>
     <TextBlock Text="Uses the selected level’s throttle mapping and limits." Style="{StaticResource Caption}" TextWrapping="Wrap" Margin="0,4,0,0"/>
     <TextBlock Text="{Binding ThrottleDemand, StringFormat={}{0:F0}%}" FontSize="24" Margin="0,12,0,0"/>
     <Slider Minimum="0" Maximum="100" TickFrequency="5" IsSnapToTickEnabled="True" Value="{Binding ThrottleDemand}" Margin="0,10"/>
     <Button Content="Hold to apply throttle · mouse or Space" Height="44" Style="{StaticResource PrimaryButton}" PreviewMouseLeftButtonDown="ThrottleDown" PreviewMouseLeftButtonUp="ThrottleUp" PreviewKeyDown="ThrottleKeyDown" PreviewKeyUp="ThrottleKeyUp" LostMouseCapture="ThrottleLost" LostKeyboardFocus="ThrottleLost"/>
    </StackPanel>
   </StackPanel>
  </Border>
   <Border Grid.Column="2" Style="{StaticResource Card}" Background="{DynamicResource InputBrush}" VerticalAlignment="Top"><StackPanel>
    <TextBlock Text="Session &amp; control" FontSize="18" FontWeight="SemiBold"/>
    <TextBlock Text="{Binding Electrical}" FontSize="20" Margin="0,16,0,8"/>
    <TextBlock Text="{Binding Message}" Style="{StaticResource Caption}" TextWrapping="Wrap"/>
  <Button Content="STOP / Disable controls" Style="{StaticResource DangerButton}" Height="44" Margin="0,16" Click="StopClick"/>
    <TextBlock Text="Controls are renewed while held. Release, lost focus, leaving this page or STOP disarms the virtual throttle." Style="{StaticResource Caption}" TextWrapping="Wrap"/>
   </StackPanel></Border>
  </Grid>
  <TextBlock Text="Throttle stops on release. Firmware expires remote commands after 1.5 seconds without renewal. Test on a supported bike with its driven wheel clear." Style="{StaticResource Caption}" TextWrapping="Wrap"/>
 </StackPanel>
</UserControl>
