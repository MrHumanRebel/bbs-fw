<UserControl xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" xmlns:d="http://schemas.microsoft.com/expression/blend/2008" xmlns:vm="clr-namespace:BBSFW.ViewModel" xmlns:local="clr-namespace:BBSFW.View" x:Class="BBSFW.View.AssistLevelsView" mc:Ignorable="d" d:DesignHeight="450" d:DesignWidth="800" Style="{StaticResource {x:Type UserControl}}">

	<Grid>
		<Grid.ColumnDefinitions>
			<ColumnDefinition Width="240"/>
			<ColumnDefinition Width="20"/>
			<ColumnDefinition/>
		</Grid.ColumnDefinitions>

		<Grid.RowDefinitions>
			<RowDefinition/>
		</Grid.RowDefinitions>

	
		<Border Style="{StaticResource Card}" Padding="16"><Grid Grid.Column="0" Grid.Row="0" Margin="0">

			<Grid.ColumnDefinitions>
				<ColumnDefinition Width="Auto"/>
				<ColumnDefinition/>
			</Grid.ColumnDefinitions>

			
			<Grid.RowDefinitions>
				<RowDefinition Height="Auto"/>
				<RowDefinition/>
			</Grid.RowDefinitions>


			<TextBlock Grid.Column="0" Grid.Row="0" Text="Profile" VerticalAlignment="Center" Margin="0,0,8,0"/>
			<ComboBox Grid.Column="1" Grid.Row="0" Margin="10 0 0 0" ItemsSource="{Binding OperationModes}" SelectedValue="{Binding SelectedOperationModePage}"/>

			<ListView Grid.Column="0" Grid.Row="1" Grid.ColumnSpan="2" ItemsSource="{Binding ConfigVm.StandardAssistLevels}" SelectedItem="{Binding SelectedAssistLevel}" Margin="0 4 0 4">
				<ListView.Style>
					<Style TargetType="{x:Type ListView}" BasedOn="{StaticResource {x:Type ListView}}">
						<Setter Property="Visibility" Value="Collapsed"/>
						<Style.Triggers>
							<DataTrigger Binding="{Binding SelectedOperationModePage.Value}" Value="Standard">
								<Setter Property="Visibility" Value="Visible"/>
							</DataTrigger>
						</Style.Triggers>
					</Style>
				</ListView.Style>
				
				<ListView.ItemTemplate>
					<DataTemplate DataType="{x:Type vm:AssistLevelViewModel}">
						<StackPanel Orientation="Vertical">
							<TextBlock FontWeight="Bold">
							<Run Text="Level "/>
							<Run Text="{Binding Id, Mode=OneWay}"/>
							</TextBlock>

							<TextBlock>
							<Run Text="{Binding SelectedType, Mode=OneWay}"/>
							</TextBlock>
						</StackPanel>
					</DataTemplate>
				</ListView.ItemTemplate>
			</ListView>

			<ListView Grid.Column="0" Grid.Row="1" Grid.ColumnSpan="2" ItemsSource="{Binding ConfigVm.SportAssistLevels}" SelectedItem="{Binding SelectedAssistLevel}" Margin="0 4 0 4">
				<ListView.Style>
					<Style TargetType="{x:Type ListView}" BasedOn="{StaticResource {x:Type ListView}}">
						<Setter Property="Visibility" Value="Collapsed"/>
						<Style.Triggers>
							<DataTrigger Binding="{Binding SelectedOperationModePage.Value}" Value="Sport">
								<Setter Property="Visibility" Value="Visible"/>
							</DataTrigger>
						</Style.Triggers>
					</Style>
				</ListView.Style>

				<ListView.ItemTemplate>
					<DataTemplate DataType="{x:Type vm:AssistLevelViewModel}">
						<StackPanel Orientation="Vertical">
							<TextBlock FontWeight="Bold">
							<Run Text="Level "/>
							<Run Text="{Binding Id, Mode=OneWay}"/>
							</TextBlock>

							<TextBlock>
							<Run Text="{Binding SelectedType, Mode=OneWay}"/>
							</TextBlock>
						</StackPanel>
					</DataTemplate>
				</ListView.ItemTemplate>
			</ListView>
		</Grid>
		
		</Border><ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Padding="0,0,12,0" Grid.Column="2"><ns2:AdaptiveCardPanel xmlns:ns2="clr-namespace:BBSFW.View.Controls" MinimumCardWidth="340"><Border Style="{StaticResource Card}"><Grid>
				<Grid.ColumnDefinitions>
					<ColumnDefinition Width="*"/>
					<ColumnDefinition Width="*"/>
				</Grid.ColumnDefinitions>

				<Grid.RowDefinitions>
					<RowDefinition Height="Auto"/>
					<RowDefinition Height="Auto"/>
					<RowDefinition Height="Auto"/>
				</Grid.RowDefinitions>


				<TextBlock Grid.Row="0" FontSize="18" FontWeight="Bold">
					<Run Text="Level "/>
					<Run Text="{Binding SelectedAssistLevel.Id, Mode=OneWay}"/>
				</TextBlock>

				<TextBlock Grid.Column="0" Grid.Row="1" Text="Type:" VerticalAlignment="Center" Margin="0 10 0 0"/>
				<ComboBox Grid.Column="1" Grid.Row="1" Margin="10 10 0 0" ItemsSource="{Binding SelectedAssistLevel.AssistBaseTypeOptions}" SelectedValue="{Binding SelectedAssistLevel.SelectedType, UpdateSourceTrigger=PropertyChanged}"/>

				<ContentControl Grid.Column="0" Grid.Row="2" Grid.ColumnSpan="2" Content="{Binding SelectedAssistLevel}">
					<ContentControl.Resources>
						<DataTemplate x:Key="EmptyTemplate" DataType="{x:Type vm:AssistLevelViewModel}">
							<Grid/>
						</DataTemplate>
						
						<DataTemplate x:Key="PasTemplate" DataType="{x:Type vm:AssistLevelViewModel}">
							<local:AssistLevelPasView/>
						</DataTemplate>
						<DataTemplate x:Key="ThrottleTemplate" DataType="{x:Type vm:AssistLevelViewModel}">
							<local:AssistLevelThrottleView/>
						</DataTemplate>
						<DataTemplate x:Key="CruiseTemplate" DataType="{x:Type vm:AssistLevelViewModel}">
							<local:AssistLevelCruiseView/>
						</DataTemplate>
					</ContentControl.Resources>

					<ContentControl.Style>
						<Style TargetType="ContentControl">
							<Setter Property="ContentTemplate" Value="{StaticResource EmptyTemplate}"/>
							<Style.Triggers>
								<DataTrigger Binding="{Binding SelectedAssistLevel.SelectedType.Value}" Value="Pas">
									<Setter Property="ContentTemplate" Value="{StaticResource PasTemplate}"/>
								</DataTrigger>
								<DataTrigger Binding="{Binding SelectedAssistLevel.SelectedType.Value}" Value="Throttle">
									<Setter Property="ContentTemplate" Value="{StaticResource ThrottleTemplate}"/>
								</DataTrigger>
								<DataTrigger Binding="{Binding SelectedAssistLevel.SelectedType.Value}" Value="Cruise">
									<Setter Property="ContentTemplate" Value="{StaticResource CruiseTemplate}"/>
								</DataTrigger>
							</Style.Triggers>
						</Style>
					</ContentControl.Style>
				</ContentControl>

			</Grid>

			</Border><Border>
            <Border.Style><Style TargetType="Border" BasedOn="{StaticResource Card}"><Setter Property="Visibility" Value="Collapsed"/>
                <Style.Triggers><DataTrigger Binding="{Binding SelectedAssistLevel.IsPasAssistAdaptiveVariant}" Value="True"><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers>
            </Style></Border.Style>
            <StackPanel>
                <TextBlock Text="Adaptive Power" FontSize="18" FontWeight="SemiBold"/>
                <TextBlock Text="A PAS power budget for this level. Low cadence reduces demand; the full budget is available from 60 rpm. Shift down if cadence falls under load." TextWrapping="Wrap" Style="{StaticResource Caption}" Margin="0,10,0,6"/>
                <ns2:ResponseChart Mode="Adaptive" BudgetPower="{Binding SelectedAssistLevel.AdaptivePowerWatts}" Focusable="False" ToolTip="Requested electrical PAS power versus cadence, before current and safety limits. Actual motor output may be lower."/>
                <TextBlock Text="Current, speed, cadence and hardware protections still apply. Throttle keeps its own current limit. The system voltage-compensation toggle does not add a second boost to this power-based variant." TextWrapping="Wrap" Style="{StaticResource Caption}" Margin="0,8,0,0"/>
            </StackPanel>
        </Border><Border Style="{StaticResource Card}"><Grid>
				<Grid.ColumnDefinitions>
					<ColumnDefinition Width="Auto"/>
					<ColumnDefinition Width="*"/>
				</Grid.ColumnDefinitions>

				<Grid.RowDefinitions>
					<RowDefinition Height="Auto"/>
					<RowDefinition Height="Auto"/>
				</Grid.RowDefinitions>

				<TextBlock Grid.Column="0" Grid.Row="0" Text="Operation Mode Toggle:" VerticalAlignment="Center" Margin="0 4 0 0"/>
				<ComboBox Grid.Column="1" Grid.Row="0" Margin="10 4 0 0" ItemsSource="{Binding ConfigVm.AssistModeSelectOptions}" SelectedValue="{Binding ConfigVm.AssistModeSelection}"/>

				<TextBlock Grid.Column="0" Grid.Row="1" Text="Startup Assist Level:" VerticalAlignment="Center" Margin="0 8 0 0"/>
				<ComboBox Grid.Column="1" Grid.Row="1" Margin="10 8 0 0" ItemsSource="{Binding ConfigVm.StartupAssistLevelOptions}" SelectedValue="{Binding ConfigVm.StartupAssistLevel}"/>

			</Grid>
		</Border><Border Style="{StaticResource Card}"><StackPanel><TextBlock Text="One system, every level" FontSize="18" FontWeight="SemiBold"/><TextBlock Text="Battery voltage compensation and the current rise curve are shared System settings. Each Standard and Sport level keeps its own current, cadence, speed and throttle ceilings." Style="{StaticResource Caption}" TextWrapping="Wrap" Margin="0,12,0,0"/></StackPanel></Border></ns2:AdaptiveCardPanel></ScrollViewer></Grid>


</UserControl>
