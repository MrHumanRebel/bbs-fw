<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
 <SolidColorBrush x:Key="CanvasBrush" Color="#F0F3F6"/>
 <SolidColorBrush x:Key="SurfaceBrush" Color="#FFFFFF"/>
 <SolidColorBrush x:Key="InputBrush" Color="#F7F9FB"/>
 <SolidColorBrush x:Key="HoverBrush" Color="#E8EEF2"/>
 <SolidColorBrush x:Key="BorderBrush" Color="#CAD3DD"/>
 <SolidColorBrush x:Key="TextBrush" Color="#18252F"/>
 <SolidColorBrush x:Key="MutedBrush" Color="#526575"/>
 <SolidColorBrush x:Key="AccentBrush" Color="#087B65"/>
 <SolidColorBrush x:Key="AccentTextBrush" Color="#FFFFFF"/>
 <SolidColorBrush x:Key="SelectionBrush" Color="#D6EEE6"/>
 <SolidColorBrush x:Key="WarningBrush" Color="#FFF0CB"/>
 <SolidColorBrush x:Key="ErrorBrush" Color="#FFE2E4"/>
 <SolidColorBrush x:Key="{x:Static SystemColors.MenuBrushKey}" Color="#FFFFFF"/>
 <SolidColorBrush x:Key="{x:Static SystemColors.MenuTextBrushKey}" Color="#18252F"/>
 <SolidColorBrush x:Key="{x:Static SystemColors.WindowBrushKey}" Color="#FFFFFF"/>
 <SolidColorBrush x:Key="{x:Static SystemColors.WindowTextBrushKey}" Color="#18252F"/>
 <SolidColorBrush x:Key="{x:Static SystemColors.ControlBrushKey}" Color="#F7F9FB"/>
 <SolidColorBrush x:Key="{x:Static SystemColors.ControlTextBrushKey}" Color="#18252F"/>
 <SolidColorBrush x:Key="{x:Static SystemColors.HighlightBrushKey}" Color="#D6EEE6"/>
 <SolidColorBrush x:Key="{x:Static SystemColors.HighlightTextBrushKey}" Color="#18252F"/>
</ResourceDictionary>
